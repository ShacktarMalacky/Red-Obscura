rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPlayer(playerId) {
      return signedIn() && request.auth.uid == playerId;
    }

    function isClanMember(clanId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clanes/$(clanId))
        && request.auth.uid in get(/databases/$(database)/documents/clanes/$(clanId)).data.members;
    }



    // All game-state writes run through authenticated Cloud Functions (Admin
    // SDK). The client SDK is read-only, with per-user mission privacy.
    match /jugadores/{playerId} {
      allow read: if ownsPlayer(playerId);
      allow write: if false;
    }

    match /jugadores_publicos/{playerId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /mensajes/{messageId} {
      allow read: if signedIn()
        && (resource.data.channel == 'global'
          || (resource.data.channel is string
            && resource.data.channel.matches('clan_[A-Za-z0-9_-]{1,128}')
            && resource.data.clanId is string
            && isClanMember(resource.data.clanId)));
      allow write: if false;
    }

    match /clanes/{clanId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /nodos/{nodeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /misiones/{missionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /progreso_misiones/{playerId} {
      allow read: if ownsPlayer(playerId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
